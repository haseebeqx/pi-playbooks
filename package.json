{
  "name": "@haseebeqx/pi-runbooks",
  "version": "0.3.0",
  "description": "Versioned, governed, self-improving runbooks for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Haseeb",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseebeqx/pi-runbooks.git"
  },
  "homepage": "https://github.com/haseebeqx/pi-runbooks#readme",
  "bugs": {
    "url": "https://github.com/haseebeqx/pi-runbooks/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agent-skills",
    "runbooks",
    "self-improvement"
  ],
  "files": [
    "extensions",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/runbooks.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typebox": "^1.0.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
